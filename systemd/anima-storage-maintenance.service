[Unit]
Description=Anima storage retention and pressure response
Documentation=https://github.com/CIRWEL/anima-mcp/blob/main/docs/operations/BACKUP_AND_RESTORE.md
After=local-fs.target
ConditionPathIsDirectory=/home/unitares-anima/.anima

[Service]
Type=oneshot
User=unitares-anima
Group=unitares-anima
UMask=0077
ExecStart=/usr/bin/python3 /home/unitares-anima/anima-mcp/scripts/storage_maintenance.py --apply
Nice=10
IOSchedulingClass=idle
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/unitares-anima/.anima
TimeoutStartSec=20min
