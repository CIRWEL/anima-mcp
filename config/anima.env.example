# Anima environment — copy to ~/.anima/anima.env on Pi
# anima.env is gitignored pattern; never commit real keys
#
# Optional identity override (only set if forcing a specific creature_id;
# normally the broker reads it from ~/anima.db, and a fresh install mints one):
# ANIMA_ID=00000000-0000-0000-0000-000000000000
#
# Required for LLM features (VQA, self-answering, etc.):
# GROQ_API_KEY=gsk_xxx   # Get free key at groq.com
#
# Required for UNITARES governance:
# UNITARES_URL=http://unitares.<your-tailnet>.ts.net:8767/mcp/
# UNITARES_AUTH=unitares:your-password
# ANIMA_GOVERNANCE_INTERVAL_SECONDS=180
# Legacy rollback only: the MCP server is the sole active action learner.
# ANIMA_BROKER_AGENCY_ENABLED=false
# Continuity gate: leave false for an established creature. If anima.db is
# missing/corrupt, or learned-self JSON is incomplete, and no verified backup
# is reachable, systemd will keep the body and mind stopped instead of silently
# minting a new identity. Set true
# only when intentionally creating a brand-new deployment.
# ANIMA_ALLOW_FRESH_START=false
# BACKUP_MAC_HOSTS=lumen-mac
# BACKUP_USER=your-mac-user
#
# Canonical operator/caretaker name (the persistent human in the growth model).
# Defaults to "operator" if unset. Set this to the caretaker's name; role aliases
# (caretaker/dashboard/human) resolve to it. An existing deployment with growth
# history keyed under a prior name MUST set it to that name, or the person record
# is recreated fresh and prior relationship history orphans:
# ANIMA_OPERATOR_NAME=YourName
#
# Required for WiFi watchdog auto-reconnect:
# WIFI_SSID=YourNetworkName
# WIFI_PASSWORD=YourPassword

GROQ_API_KEY=
UNITARES_AUTH=
ANIMA_GOVERNANCE_INTERVAL_SECONDS=180
ANIMA_ALLOW_FRESH_START=false
WIFI_SSID=
WIFI_PASSWORD=
